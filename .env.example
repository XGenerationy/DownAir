# DownAir Configuration
# install.sh generates all secrets automatically.

# Application
APP_NAME=DownAir
APP_URL=https://downair.net
APP_PORT=3001
NODE_ENV=production

# Database (Docker Compose overrides DATABASE_URL automatically)
POSTGRES_DB=downair
POSTGRES_USER=downair
POSTGRES_PASSWORD=changeme

# Security (auto-generated by install.sh)
JWT_SECRET=
ENCRYPTION_KEY=
HMAC_SECRET=

# Admin
ADMIN_EMAIL=admin@downair.net

# Setup Status
SETUP_COMPLETED=false

# Optional
# COOKIE_DOMAIN=.downair.net
# YT_DLP_PATH=yt-dlp
