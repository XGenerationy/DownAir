# DownAir Configuration
# Run setup wizard on first launch or configure manually.

# Application
APP_NAME=DownAir
APP_URL=http://localhost:5173
APP_PORT=3001
NODE_ENV=development

# Database (configured via setup wizard)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/downair
DB_SSL=false

# Security (auto-generated on setup)
# JWT_SECRET, ENCRYPTION_KEY, HMAC_SECRET must each be ≥ 32 chars when SETUP_COMPLETED=true.
JWT_SECRET=
ENCRYPTION_KEY=
HMAC_SECRET=

# Admin (bootstrapped via setup wizard; plaintext password is NOT persisted here)
ADMIN_EMAIL=admin@downair.net

# Setup Status — server refuses to start if 'true' with missing secrets above.
SETUP_COMPLETED=false

# Optional
# COOKIE_DOMAIN=.downair.net
# YT_DLP_PATH=/usr/local/bin/yt-dlp
